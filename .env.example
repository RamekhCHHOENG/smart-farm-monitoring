# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Generate random values with:  openssl rand -hex 24

# Shared secret that sensor nodes send in the X-Device-Key header.
# Leave empty in development: the server then prints a temporary key at startup.
FARM_DEVICE_KEY=

# Password for the demo users owner / worker / technician (only used when the database is first created).
# Leave empty to have a random password generated and printed once in the server log.
FARM_DEMO_PASSWORD=

# true = demo farm with two zones; false = empty farm for a real installation (first start only)
FARM_DEMO_DATA=true

# Optional: Telegram alerts (create a bot with @BotFather). Leave empty to log alerts to the console.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: PostgreSQL (run the backend with --spring.profiles.active=postgres)
DB_URL=jdbc:postgresql://localhost:5432/smartfarm
DB_USERNAME=smartfarm
DB_PASSWORD=

# Time zone of the farm; schedules run on this clock (important when the server runs in UTC)
FARM_TIME_ZONE=Asia/Phnom_Penh

# Built-in device simulator (true until you connect real hardware)
FARM_SIMULATOR_ENABLED=true

# Frontend origin allowed to call the API
FARM_CORS_ORIGINS=http://localhost:3000
