@startuml use-case-company
!include style.iuml
left to right direction

actor "Company Admin" as Admin
actor "Company Support" as Support
actor "Farm Owner" as Owner
actor "Technician" as Tech

rectangle "Smart Farm Monitoring System: company and customer farms" {
  usecase "UC-12 Manage Customer Farms" as UC12
  usecase "UC-13 Invite and Activate Account" as UC13
  usecase "UC-14 Work on a Customer Farm" as UC14
  usecase "UC-15 Manage Device Catalog" as UC15
  usecase "UC-16 Allow Support Access" as UC16
  usecase "UC-11 Manage Staff Accounts" as UC11
  usecase "Check Farm Access" as Access
}

Admin --> UC12
Admin --> UC14
Admin --> UC15
Support --> UC14
Owner --> UC11
Owner --> UC16
Owner --> UC15
Tech --> UC15

UC12 ..> UC13 : <<include>>
UC11 ..> UC13 : <<include>>
UC14 ..> Access : <<include>>
UC16 ..> Access : <<extend>>\n[owner turns support off]
@enduml
